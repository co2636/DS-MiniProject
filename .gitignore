# ========================================
# 운영체제 / 에디터 임시 파일
# ========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ========================================
# Python 가상환경
# 현재 프로젝트에 존재하는 두 가상환경 모두 제외
# ========================================
venv/
.venv/
DS-MiniProject/
env/
ENV/

# ========================================
# Python 캐시 / 빌드 / 테스트 산출물
# ========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# ========================================
# Jupyter 임시 파일
# 실행 결과가 들어 있는 최종 .ipynb는 추적하고,
# 체크포인트와 자동 백업본만 제외
# ========================================
.ipynb_checkpoints/
.virtual_documents/
*.backup-*.ipynb
*.nbconvert.ipynb

# ========================================
# 원본 데이터
# .mat 파일은 수 GB이므로 Git/GitHub에 올리지 않음
# README에 다운로드 방법과 배치별 파일명을 기록할 것
# ========================================
data/
*.mat
*.h5
*.hdf5
*.zip
*.tar
*.tar.gz

# ========================================
# 전처리 후 자동 생성 데이터
# 노트북 실행으로 다시 만들 수 있으므로 제외
# ========================================
processed/

# ========================================
# 모델·캐시·로그
# ========================================
models/
checkpoints/
cache/
*.pkl
*.pickle
*.joblib
*.log

# ========================================
# 환경 변수와 비밀정보
# ========================================
.env
.env.*
!.env.example
*.pem
*.key

# ========================================
# 로컬 임시 산출물
# 최종 figures/와 output/pdf/는 제출·리뷰용이므로 추적 가능
# ========================================
tmp/
temp/

/output/